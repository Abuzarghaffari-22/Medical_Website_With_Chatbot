APP_NAME="Medical Clinic AI Service"
ENVIRONMENT=development
PORT=8000

# Generate: openssl rand -hex 32
SECRET_KEY=<generate-32-char-hex>

# HuggingFace token — needs "Make calls to Inference Providers" permission
# Create at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_<your-token-here>

# Model options (all free):
#   HuggingFaceH4/zephyr-7b-beta          ← reliable default
#   meta-llama/Llama-3.1-8B-Instruct      ← best quality
#   mistralai/Mistral-7B-Instruct-v0.3    ← fast
#   microsoft/Phi-3.5-mini-instruct        ← smallest/fastest
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

HF_MAX_NEW_TOKENS=300
HF_TEMPERATURE=0.3
HF_TOP_P=0.9
HF_TIMEOUT=60

# CORS — comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
TRUSTED_HOSTS=localhost,127.0.0.1

RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=15

# Optional: Redis URL for persistent rate limiting across restarts/workers
# Leave empty to use in-memory (fine for single-worker dev)
# Example: redis://localhost:6379
REDIS_URL=

# MUST match INTERNAL_API_KEY in backend/.env
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=<generate-32-char-hex>

# Clinic Information
CLINIC_NAME="MediCare Clinic"
CLINIC_PHONE="+1-800-MEDICARE"
CLINIC_EMAIL="info@medicareclinic.com"
CLINIC_ADDRESS="123 Health Ave, Medical City, MC 10001"
CLINIC_HOURS="Monday-Friday: 8AM-6PM | Saturday: 9AM-2PM | Sunday: Closed"
CLINIC_EMERGENCY="For emergencies, dial 911 or visit the nearest ER"

MAX_CONVERSATION_HISTORY=10
ENABLE_SYMPTOM_TRIAGE=true
ENABLE_CONVERSATION_SUMMARY=true
