NODE_ENV=development
PORT=5000

# MongoDB — local or Atlas connection string
MONGODB_URI=mongodb://localhost:27017/medical-clinic
MONGODB_TEST_URI=mongodb://localhost:27017/medical-clinic-test

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<generate-64-char-hex>
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=<generate-different-64-char-hex>
JWT_REFRESH_EXPIRE=7d

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=35000
# Must match INTERNAL_API_KEY in ai-services/.env
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=<generate-32-char-hex>

# Clinic Info
CLINIC_PHONE=+1-800-MEDICARE
CLINIC_EMAIL=info@medicareclinic.com

# Logging
LOG_LEVEL=debug
